{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j-slice.dev/schema/js-thermal-model-fit-1",
  "title": "J-Slice measured thermal model fit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "model_version", "machine_fingerprint_hash",
    "printer_id", "material_family", "nozzle_diameter_mm", "layer_height_mm", "line_width_mm",
    "ambient_temperature_c", "deposition_temperature_c", "bed_temperature_c", "fan_percent", "cooling_time_constant_s", "fit_log_residual_rms",
    "fit_sample_count", "calibration_dataset_hash", "provenance", "calibrated",
    "synthetic", "diagnostics"],
  "properties": {
    "schema_version": {"const": "js-thermal-model-fit-1"},
    "model_id": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "machine_fingerprint_hash": {"type": "string", "minLength": 1},
    "printer_id": {"type": "string", "minLength": 1},
    "material_family": {"type": "string", "minLength": 1},
    "material_lot": {"type": "string"},
    "nozzle_diameter_mm": {"type": "number", "exclusiveMinimum": 0},
    "layer_height_mm": {"type": "number", "exclusiveMinimum": 0},
    "line_width_mm": {"type": "number", "exclusiveMinimum": 0},
    "ambient_temperature_c": {"type": "number"},
    "deposition_temperature_c": {"type": "number"},
    "bed_temperature_c": {"type": "number"},
    "fan_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "cooling_time_constant_s": {"type": "number", "exclusiveMinimum": 0},
    "fit_log_residual_rms": {"type": "number", "minimum": 0},
    "fit_sample_count": {"type": "integer", "minimum": 3},
    "calibration_dataset_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provenance": {"const": "measured"},
    "calibrated": {"const": true},
    "synthetic": {"const": false},
    "diagnostics": {"type": "object", "additionalProperties": false,
      "required": ["contact_age_min_s", "contact_age_max_s", "temperature_min_c", "temperature_max_c", "uncertainty_c"],
      "properties": {"contact_age_min_s": {"type": "number", "minimum": 0}, "contact_age_max_s": {"type": "number", "minimum": 0}, "temperature_min_c": {"type": "number"}, "temperature_max_c": {"type": "number"}, "uncertainty_c": {"type": "number", "minimum": 0}}}
  }
}
