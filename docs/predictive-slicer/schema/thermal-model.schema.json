{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j-slice.dev/schema/js-thermal-model-1",
  "title": "J-Slice thermal model contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "model_version", "provenance", "calibrated", "synthetic"],
  "properties": {
    "schema_version": {"const": "js-thermal-model-1"},
    "model_id": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "machine_fingerprint_hash": {"type": "string"},
    "printer_family": {"type": "string"},
    "material_family": {"type": "string"},
    "nozzle_diameter_mm": {"type": "number", "exclusiveMinimum": 0},
    "layer_height_mm": {"type": "number", "exclusiveMinimum": 0},
    "line_width_mm": {"type": "number", "exclusiveMinimum": 0},
    "ambient_temperature_c": {"type": "number"},
    "deposition_temperature_c": {"type": "number"},
    "bed_temperature_c": {"type": "number"},
    "fan_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "glass_transition_temperature_c": {"type": "number"},
    "bonding_minimum_temperature_c": {"type": "number"},
    "bonding_maximum_temperature_c": {"type": "number"},
    "cooling_time_constant_s": {"type": "number", "exclusiveMinimum": 0},
    "initial_temperature_uncertainty_c": {"type": "number", "minimum": 0},
    "model_uncertainty_c": {"type": "number", "minimum": 0},
    "target_contact_age_s": {"type": "number", "minimum": 0},
    "calibration_dataset_hash": {"type": "string"},
    "provenance": {"enum": ["synthetic", "uncalibrated", "measured", "inferred"]},
    "calibrated": {"type": "boolean"},
    "synthetic": {"type": "boolean"}
  }
}
