{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j-slice.dev/schema/js-thermal-schedule-1",
  "title": "J-Slice analysis-only thermal schedule proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "machine_fingerprint_hash", "model_id", "model_hash",
    "analysis_only", "recommendation_eligible", "eligibility_reason", "baseline_order",
    "proposed_order", "baseline_timeline", "proposed_timeline", "neighbor_graph",
    "reorderability", "baseline_score", "proposed_score", "changes", "warnings",
    "candidate_swaps_considered", "search_passes"],
  "properties": {
    "schema_version": {"const": "js-thermal-schedule-1"},
    "machine_fingerprint_hash": {"type": "string"},
    "model_id": {"type": "string"},
    "model_hash": {"type": "string", "minLength": 1},
    "analysis_only": {"const": true},
    "recommendation_eligible": {"type": "boolean"},
    "eligibility_reason": {"type": "string"},
    "baseline_order": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "proposed_order": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "baseline_timeline": {"$ref": "#/$defs/timeline"},
    "proposed_timeline": {"$ref": "#/$defs/timeline"},
    "neighbor_graph": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "cell_size_mm", "pair_limit", "bounded", "paths", "neighbors", "warnings"],
      "properties": {
        "schema_version": {"const": "js-thermal-neighbor-1"},
        "cell_size_mm": {"type": "number", "exclusiveMinimum": 0},
        "pair_limit": {"type": "integer", "minimum": 1},
        "bounded": {"const": true},
        "paths": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["path_id", "source_order", "source_object", "source_feature", "generating_pass", "source_layer", "dependencies", "tool_id", "material_id", "cancel_object_id", "duration_s", "deposition_temperature_c", "uncertainty_c"],
          "properties": {"path_id": {"type": "integer", "minimum": 1}, "source_order": {"type": "integer", "minimum": 0}, "source_object": {"type": "string"}, "source_feature": {"type": "string"}, "generating_pass": {"type": "string"}, "source_layer": {"type": ["integer", "null"], "minimum": 0}, "dependencies": {"type": "array", "items": {"type": "integer", "minimum": 1}}, "tool_id": {"type": ["integer", "null"], "minimum": 0}, "material_id": {"type": "string"}, "cancel_object_id": {"type": "string"}, "duration_s": {"type": "number", "minimum": 0}, "deposition_temperature_c": {"type": "number"}, "uncertainty_c": {"type": "number", "minimum": 0}}}},
        "neighbors": {"type": "array", "items": {"$ref": "#/$defs/neighbor"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reorderability": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["path_id", "reorderable", "reason"],
      "properties": {"path_id": {"type": "integer", "minimum": 1}, "reorderable": {"type": "boolean"}, "reason": {"type": "string"}}}},
    "baseline_score": {"$ref": "#/$defs/score"},
    "proposed_score": {"$ref": "#/$defs/score"},
    "changes": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "candidate_swaps_considered": {"type": "integer", "minimum": 0},
    "search_passes": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "timeline": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["path_id", "start_time_s", "end_time_s"],
      "properties": {"path_id": {"type": "integer", "minimum": 1}, "start_time_s": {"type": "number", "minimum": 0}, "end_time_s": {"type": "number", "minimum": 0}}}},
    "neighbor": {"type": "object", "additionalProperties": false,
      "required": ["first_path", "second_path", "minimum_distance_mm", "contact_age_s", "estimated_temperature_c", "uncertainty_c", "contact_type", "confidence"],
      "properties": {"first_path": {"type": "integer", "minimum": 1}, "second_path": {"type": "integer", "minimum": 1}, "minimum_distance_mm": {"type": "number", "minimum": 0}, "contact_age_s": {"type": "number", "minimum": 0}, "estimated_temperature_c": {"type": "number"}, "uncertainty_c": {"type": "number", "minimum": 0}, "contact_type": {"const": "geometric_proximity"}, "confidence": {"enum": ["high", "bounded"]}}},
    "score": {"type": "object", "additionalProperties": false,
      "required": ["total", "travel", "thermal_debt", "hot_penalty", "cold_penalty", "tool_switches", "uncertainty", "legacy_deviation"],
      "properties": {"total": {"type": "number"}, "travel": {"type": "number", "minimum": 0}, "thermal_debt": {"type": "number", "minimum": 0}, "hot_penalty": {"type": "number", "minimum": 0}, "cold_penalty": {"type": "number", "minimum": 0}, "tool_switches": {"type": "number", "minimum": 0}, "uncertainty": {"type": "number", "minimum": 0}, "legacy_deviation": {"type": "number", "minimum": 0}}}
  }
}
