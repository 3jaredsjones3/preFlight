{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jslice:verifier-machine:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "machine_id", "dialect", "build_min_mm", "build_max_mm", "axis_velocity_mm_s", "axis_acceleration_mm_s2", "max_feedrate_mm_s", "max_acceleration_mm_s2", "max_bed_temperature_c", "max_retraction_mm", "max_extrusion_step_mm", "fan_count", "heaters", "tools"],
  "properties": {
    "schema_version": {"const": "js-machine-1"},
    "machine_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "dialect": {"const": "marlin-cartesian-1"},
    "build_min_mm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -10000, "maximum": 10000}},
    "build_max_mm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -10000, "maximum": 10000}},
    "axis_velocity_mm_s": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000}},
    "axis_acceleration_mm_s2": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000}},
    "max_feedrate_mm_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
    "max_acceleration_mm_s2": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000},
    "max_bed_temperature_c": {"type": "number", "minimum": 0, "maximum": 500},
    "max_retraction_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
    "max_extrusion_step_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
    "fan_count": {"type": "integer", "minimum": 1, "maximum": 8},
    "heaters": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 500}},
    "tools": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["heater", "offset_mm", "envelope_min_mm", "envelope_max_mm", "filament_diameter_mm", "max_flow_mm3_s", "min_extrusion_temperature_c"],
      "properties": {
        "heater": {"type": "integer", "minimum": 0, "maximum": 7},
        "offset_mm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -1000, "maximum": 1000}},
        "envelope_min_mm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -1000, "maximum": 0}},
        "envelope_max_mm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1000}},
        "filament_diameter_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "max_flow_mm3_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000},
        "min_extrusion_temperature_c": {"type": "number", "minimum": 0, "maximum": 500}
      }
    }}
  }
}
