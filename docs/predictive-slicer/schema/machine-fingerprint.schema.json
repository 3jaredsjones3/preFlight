{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://j-slice.local/schema/machine-fingerprint.schema.json",
  "title": "J-Slice machine fingerprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "content_hash", "build_volume_mm", "axes", "extrusion", "tool_envelope_mm", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "build_volume_mm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"$ref": "#/$defs/vec3"},
        "max": {"$ref": "#/$defs/vec3"}
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"$ref": "#/$defs/axis"},
        "y": {"$ref": "#/$defs/axis"},
        "z": {"$ref": "#/$defs/axis"}
      }
    },
    "extrusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_volumetric_flow_mm3_s", "pressure_time_constant_s"],
      "properties": {
        "max_volumetric_flow_mm3_s": {"type": "number", "exclusiveMinimum": 0},
        "pressure_time_constant_s": {"type": "number", "minimum": 0},
        "fit_uncertainty": {"type": "number", "minimum": 0}
      }
    },
    "tool_envelope_mm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["radius", "below_reference", "above_reference"],
      "properties": {
        "radius": {"type": "number", "minimum": 0},
        "below_reference": {"type": "number", "minimum": 0},
        "above_reference": {"type": "number", "minimum": 0}
      }
    },
    "resonance_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frequency_hz", "damping_ratio", "gain"],
        "properties": {
          "frequency_hz": {"type": "number", "exclusiveMinimum": 0},
          "damping_ratio": {"type": "number", "exclusiveMinimum": 0},
          "gain": {"type": "number", "minimum": 0}
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["created_at", "calibration_suite", "source_hashes"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "calibration_suite": {"type": "string"},
        "source_hashes": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "minItems": 3,
      "maxItems": 3
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_speed_mm_s", "max_acceleration_mm_s2", "max_jerk_mm_s3"],
      "properties": {
        "max_speed_mm_s": {"type": "number", "exclusiveMinimum": 0},
        "max_acceleration_mm_s2": {"type": "number", "exclusiveMinimum": 0},
        "max_jerk_mm_s3": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
