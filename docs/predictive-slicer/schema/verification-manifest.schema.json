{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jslice:verification-manifest:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "fingerprint_sha256", "program_sha256", "initial_state", "objects", "required_properties", "end_marker"],
  "properties": {
    "schema_version": {"const": "js-verification-1"},
    "fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "end_marker": {"const": "; preflight_config = end"},
    "objects": {"type": "array", "maxItems": 10000, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "required_properties": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "initial_state": {
      "type": "object", "additionalProperties": false,
      "required": ["position_mm", "e_mm", "tool", "heater_temperature_c", "bed_temperature_c", "fan_pwm"],
      "properties": {
        "position_mm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -10000, "maximum": 10000}},
        "e_mm": {"type": "number", "minimum": -10000, "maximum": 10000},
        "tool": {"type": "integer", "minimum": 0, "maximum": 7},
        "heater_temperature_c": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "number", "minimum": 0, "maximum": 500}},
        "bed_temperature_c": {"type": "number", "minimum": 0, "maximum": 500},
        "fan_pwm": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "integer", "minimum": 0, "maximum": 255}}
      }
    }
  }
}
